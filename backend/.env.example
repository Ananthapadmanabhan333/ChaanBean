# Copy to .env. The defaults run the entire system with no vendor account.

ENV=local
DEBUG=true

# --- Database roles ---------------------------------------------------------
# Three roles, deliberately. RLS is bypassed unconditionally by superusers and
# by BYPASSRLS roles *even with FORCE*, so the application must not connect as
# the owner — otherwise every policy is decoration and the isolation tests pass
# against nothing. `python -m app.db check` verifies this.
DATABASE_URL=postgresql+psycopg://crp_app:crp_app@localhost:5432/crp
DATABASE_URL_WORKER=postgresql+psycopg://crp_worker:crp_worker@localhost:5432/crp
DATABASE_URL_ADMIN=postgresql+psycopg://crp:crp@localhost:5432/crp
REDIS_URL=redis://localhost:6379/0

# --- Adapter selection ------------------------------------------------------
# These lines are the whole difference between the local build and production.
# See docs/going-live.md.
TTS_BACKEND=local              # local | polly
STORAGE_BACKEND=local          # local | s3
TELEPHONY_BACKEND=fake         # fake | asterisk
SMS_BACKEND=fake               # fake | gupshup
WHATSAPP_BACKEND=fake          # fake | meta
EMAIL_BACKEND=fake             # fake | ses
# Company registries. This pair is different in kind from the ones above: it
# decides what the system may *claim*, not just who does the work. `local`
# reports REGISTRY provenance and can support an identifier-tier match;
# `manual` — a person read the government portal and typed what they saw —
# reports USER_PROVIDED and can never reach that tier or be published.
GST_BACKEND=local              # local | manual
MCA_BACKEND=local              # local | manual

# --- Contact safety ---------------------------------------------------------
# Outside production, refuse to contact anyone not listed here whenever a real
# delivery backend is configured. With every backend on `fake` nothing leaves
# the building and the guard stands down, so a local demo still runs.
CONTACT_ALLOWLIST=
CONTACT_ALLOWLIST_ENFORCED=true

AUDIO_DIR=./var/audio
ASTERISK_SOUNDS_DIR=./var/asterisk-sounds
AUDIO_SAMPLE_RATE=8000
DEFAULT_VOICE_ID=Kajal

# --- AWS (unset until an account exists) ------------------------------------
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=

# --- Asterisk ARI -----------------------------------------------------------
# ARI credentials are unrestricted call-origination authority. Keep the listener
# on loopback or a private subnet; an internet-reachable ARI is toll fraud
# waiting to happen.
ARI_BASE_URL=http://localhost:8088/ari
ARI_USERNAME=crp
ARI_PASSWORD=crp
ARI_APP_NAME=crp-outbound
ARI_ENDPOINT_TEMPLATE=PJSIP/{number}@local-test
# With a carrier trunk this becomes:  PJSIP/{number}@vobiz-trunk

# --- Policy -----------------------------------------------------------------
DND_MAX_AGE_DAYS=7
CALL_STUCK_AFTER_SEC=180
SCHEDULER_TICK_SECONDS=10
SCHEDULER_BATCH_SIZE=50

# --- Auth -------------------------------------------------------------------
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=720
# Keys the stored PAN digest. Set this to something the database dump does not
# contain: a PAN is held beside its own last four characters, so an unkeyed hash
# of one is about 10^8 guesses away from the number itself. Changing it
# invalidates the digests already written.
PAN_PEPPER=dev-only-change-me

# --- Identity provider ------------------------------------------------------
# Supabase answers "who is this person". It does NOT answer "which tenant are
# they in" or "what may they do" — those stay in this system's tables behind
# its own RLS, because a Supabase token's `user_metadata` is writable by the
# user and so proves nothing about their role.
AUTH_BACKEND=local             # local | supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<publishable anon key — safe in the browser>
# Legacy projects only. Newer ones sign asymmetrically and this stays unset,
# in which case the public keys are read from the project's JWKS endpoint.
# SUPABASE_JWT_SECRET=<legacy HS256 secret>
