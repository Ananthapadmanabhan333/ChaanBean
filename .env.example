# Copy to .env. The defaults run the whole system with no vendor account.

ENV=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://crp:crp@localhost:5432/crp
REDIS_URL=redis://localhost:6379/0

# --- Adapter selection ------------------------------------------------------
# These three lines are the difference between the local build and production.
# Leave them as-is until Vobiz and AWS are provisioned.
TTS_BACKEND=local              # local | polly
STORAGE_BACKEND=local          # local | s3
TELEPHONY_BACKEND=fake         # fake | asterisk

AUDIO_DIR=./var/audio
AUDIO_SAMPLE_RATE=8000
DEFAULT_VOICE_ID=Kajal

# --- AWS (Block 3 switch to polly) ------------------------------------------
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=

# --- Asterisk ARI (Block 4) -------------------------------------------------
ARI_BASE_URL=http://localhost:8088/ari
ARI_USERNAME=crp
ARI_PASSWORD=crp
ARI_APP_NAME=crp-outbound
# Local testing dials a locally registered endpoint. With a Vobiz trunk this
# becomes: PJSIP/{number}@vobiz-trunk
ARI_ENDPOINT_TEMPLATE=PJSIP/{number}@local-test
ARI_ORIGINATE_TIMEOUT_SEC=30

# --- Policy -----------------------------------------------------------------
DND_MAX_AGE_DAYS=7
CALL_STUCK_AFTER_SEC=180

# --- Auth -------------------------------------------------------------------
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=720
